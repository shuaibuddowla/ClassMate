<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glass boundary with blue refraction stroke -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/cm_bottom_nav_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/cm_border_glass" />
        </shape>
    </item>
    <!-- Liquid specular top highlight -->
    <item
        android:left="1.5dp"
        android:top="1dp"
        android:right="1.5dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
