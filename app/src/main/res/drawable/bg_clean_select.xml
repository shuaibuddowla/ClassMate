<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/cm_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/cm_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/cm_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/cm_border" />
        </shape>
    </item>
</selector>
