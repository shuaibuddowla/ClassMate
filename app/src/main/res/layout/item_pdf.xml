<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="82dp"
    android:background="@drawable/bg_library_row_divider_html"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <FrameLayout android:id="@+id/iconContainer" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_library_file_icon_red">
        <ImageView android:id="@+id/ivFileIcon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_file_pdf" app:tint="#FF6B7A" />
        <TextView android:id="@+id/tvFileBadge" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#12152A" android:textSize="15sp" android:textStyle="bold" tools:text="Boolean algebra and K-maps" />
            <TextView android:id="@+id/tvLabTag" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="LAB" android:textColor="@color/cm_success" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/tvSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:textColor="#2F45F0" android:textSize="13sp" tools:text="Digital Electronics" />
        <TextView android:id="@+id/tvFileMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:ellipsize="end" android:maxLines="1" android:textColor="#565C75" android:textSize="11.5sp" tools:text="3.2 MB - uploaded 2 days ago" />
        <TextView android:id="@+id/tvDescription" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        <TextView android:id="@+id/tvUploadedBy" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/btnDownloadView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/btnFavorite" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:src="@drawable/ic_star_outline" app:tint="#565C75" />
    <ImageView android:id="@+id/btnDelete" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="9dp" android:src="@drawable/ic_delete" android:visibility="gone" app:tint="@color/cm_error" />
    <ProgressBar android:id="@+id/progressDownload" style="?android:attr/progressBarStyleHorizontal" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>
