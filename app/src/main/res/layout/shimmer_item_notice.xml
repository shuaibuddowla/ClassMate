<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:strokeColor="@color/cm_notice_premium_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notice_premium_general"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingTop="14dp"
            android:paddingBottom="2dp">

            <!-- Title & megaphone header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_notice_premium_accent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="20dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_shimmer_rect" />
            </LinearLayout>

            <!-- Preview body lines -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_rect" />

            <View
                android:layout_width="230dp"
                android:layout_height="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- Meta line: Date & Translate pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="120dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="68dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_shimmer_rect" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:background="@color/cm_notice_premium_stroke"
                android:alpha="0.6" />

            <!-- Footer actions bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_shimmer_rect" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_shimmer_rect" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
