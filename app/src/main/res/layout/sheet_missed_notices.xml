<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingTop="12dp"
    android:paddingBottom="36dp"
    android:paddingHorizontal="20dp"
    android:maxHeight="580dp">

    <!-- Top Grab Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_dynamic_island_icon">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notice"
                app:tint="#FFFFFF"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:text="Missed Notices"
                    android:textColor="@color/cm_peek_sheet_title"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvSheetCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_speed_dial_pill"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:textColor="@color/cm_primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    tools:text="3 new" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSheetSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cm_peek_sheet_subtitle"
                android:textSize="12sp"
                android:text="Catch up on notices you haven't seen yet" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSheetClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/cm_dynamic_island_dismiss_icon"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/cm_peek_sheet_divider" />

    <!-- Recycler View for Missed Notices -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMissedNotices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="340dp"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false"
        tools:listitem="@layout/item_missed_notice_peek"
        tools:itemCount="3" />

    <!-- Bottom Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Mark All as Read Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetMarkAllRead"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Mark all as read"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            app:cornerRadius="14dp" />

        <!-- Go to Full Feed Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetGoToFeed"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.2"
            android:text="Open Notices Feed"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            app:backgroundTint="@color/cm_primary"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="#FFFFFF"
            app:iconSize="16dp" />
    </LinearLayout>

</LinearLayout>
