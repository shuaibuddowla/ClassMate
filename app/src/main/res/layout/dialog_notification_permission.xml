<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogNotificationPermissionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_permission_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="@color/cm_border" />

    <!-- Icon Badge Header -->
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge_pill"
        android:backgroundTint="#CCFBF1">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_notice"
            app:tint="#0D9488"
            android:contentDescription="Notification Icon" />
    </FrameLayout>

    <!-- Title & Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Turn On Notifications"
        android:textColor="@color/cm_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="12dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="ClassMate needs notification access so you never miss critical announcements and daily schedules."
        android:textColor="@color/cm_text_secondary"
        android:textSize="13.5sp" />

    <!-- Reasons Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_fund_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Reason 1: Notices & Emergency Cancellations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#FEE2E2">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_notice"
                    app:tint="#DC2626"
                    android:contentDescription="Notice Alerts" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgent Notices &amp; Cancellations"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Immediate alerts when classes are cancelled, rescheduled, or emergency notices are issued."
                    android:textColor="@color/cm_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/cm_border" />

        <!-- Reason 2: Class & Timetable Reminders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#E0F2FE">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_timetable"
                    app:tint="#0284C7"
                    android:contentDescription="Timetable Alerts" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Class &amp; Room Reminders"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Timely reminders before your lectures start with room numbers so you are never late."
                    android:textColor="@color/cm_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/cm_border" />

        <!-- Reason 3: Batch Fund & Transparency -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="#DCFCE7">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fund_wallet"
                    app:tint="#16A34A"
                    android:contentDescription="Batch Fund Alerts" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batch Fund Receipts &amp; Dues"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Instant confirmation when deposits are recorded and transparency updates on dues."
                    android:textColor="@color/cm_text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="1.5dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Primary Action: Allow / Open Settings -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAllowNotifications"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Allow Notifications"
        android:textSize="14.5sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        app:backgroundTint="#0D9488"
        app:cornerRadius="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

    <!-- Secondary Action: Maybe Later -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissNotificationPrompt"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="Maybe Later"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:textColor="@color/cm_text_secondary"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>
