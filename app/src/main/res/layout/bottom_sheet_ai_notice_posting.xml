<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Bottom sheet drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- AI Agent Badge Header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_poll_chip"
        android:backgroundTint="#1A7C3AED"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sparkle"
            app:tint="#7C3AED" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="ClassMate AI Engine"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#7C3AED" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Publishing Notice"
        android:textColor="@color/cm_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="ClassMate AI is preparing and broadcasting your notice"
        android:textColor="@color/cm_text_secondary"
        android:textSize="13sp" />

    <!-- Step 1: Content Analysis -->
    <LinearLayout
        android:id="@+id/step1Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ProgressBar
                android:id="@+id/pbStep1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/cm_primary" />
            <ImageView
                android:id="@+id/ivStep1Done"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#10B981"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvStep1Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Analyzing notice text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cm_text_primary" />
            <TextView
                android:id="@+id/tvStep1Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Understanding content, intent, and language"
                android:textSize="12sp"
                android:textColor="@color/cm_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Step 2: AI Title & Formatting -->
    <LinearLayout
        android:id="@+id/step2Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ProgressBar
                android:id="@+id/pbStep2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/cm_primary"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/ivStep2Pending"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sparkle"
                app:tint="@color/cm_text_muted" />
            <ImageView
                android:id="@+id/ivStep2Done"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#10B981"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvStep2Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detecting title with ClassMate AI"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cm_text_secondary" />
            <TextView
                android:id="@+id/tvStep2Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Generating concise title and formatting message"
                android:textSize="12sp"
                android:textColor="@color/cm_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI Generated Title Live Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTitlePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#0D7C3AED"
        app:strokeColor="#337C3AED"
        app:strokeWidth="1dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="#7C3AED" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="DETECTED TITLE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#7C3AED" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvDetectedTitlePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cm_text_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Step 3: Attachments (Conditional) -->
    <LinearLayout
        android:id="@+id/step3Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ProgressBar
                android:id="@+id/pbStep3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/cm_primary"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/ivStep3Pending"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_open_external"
                app:tint="@color/cm_text_muted" />
            <ImageView
                android:id="@+id/ivStep3Done"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#10B981"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvStep3Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uploading attachments"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cm_text_muted" />
            <TextView
                android:id="@+id/tvStep3Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Uploading document or photo..."
                android:textSize="12sp"
                android:textColor="@color/cm_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Step 4: Broadcasting -->
    <LinearLayout
        android:id="@+id/step4Container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ProgressBar
                android:id="@+id/pbStep4"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/cm_primary"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/ivStep4Pending"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notice_megaphone_art"
                android:alpha="0.4" />
            <ImageView
                android:id="@+id/ivStep4Done"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#10B981"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvStep4Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Broadcasting to batch"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cm_text_muted" />
            <TextView
                android:id="@+id/tvStep4Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Publishing notice and notifying batch members"
                android:textSize="12sp"
                android:textColor="@color/cm_text_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- Continue in background action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinueInBackground"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Continue in background"
        android:textSize="13sp"
        android:textColor="@color/cm_primary"
        app:cornerRadius="12dp" />

</LinearLayout>
