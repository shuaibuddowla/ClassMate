<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootFoundCardSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Top Header Bar with Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_badge_green"
            android:backgroundTint="#2010B981">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rfid_signal"
                app:tint="#10B981"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSheetHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ClassMate Smart Card"
                android:textColor="@color/cm_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSheetHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NFC Tap · Instant Campus Identity"
                android:textColor="@color/cm_text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseFoundCard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/cm_text_muted"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/progressLoadingStudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone" />

    <!-- 1. REGISTERED STUDENT VIEW -->
    <LinearLayout
        android:id="@+id/layoutRegisteredStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="visible">

        <!-- Student Profile Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/cm_surface"
            app:strokeColor="@color/cm_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Avatar + Main Identity Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Avatar Box with Initials Fallback -->
                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivStudentAvatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                        <TextView
                            android:id="@+id/tvStudentInitials"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:gravity="center"
                            android:background="@drawable/bg_badge_green"
                            android:backgroundTint="#2510B981"
                            android:textColor="#10B981"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="SA" />
                    </FrameLayout>

                    <!-- Student Details -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStudentName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cm_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="Shuaib Ahmed" />

                        <TextView
                            android:id="@+id/tvStudentRoll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/cm_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="CE25032" />

                        <TextView
                            android:id="@+id/tvStudentDeptBatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/cm_text_secondary"
                            android:textSize="12sp"
                            tools:text="CSE 22 · Computer Science &amp; Engineering" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Status Pills Row -->
                <com.google.android.flexbox.FlexboxLayout
                    xmlns:flexbox="http://schemas.android.com/apk/res-auto"
                    android:id="@+id/layoutPills"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    flexbox:flexWrap="wrap"
                    flexbox:justifyContent="flex_start">

                    <!-- Verified Status Pill -->
                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_badge_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="✓ Verified Student"
                        android:textColor="#10B981"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <!-- Blood Group Pill -->
                    <TextView
                        android:id="@+id/tvBloodBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_segmented_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="#EF4444"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        tools:text="🩸 O+" />

                    <!-- Attendance % Pill -->
                    <TextView
                        android:id="@+id/tvAttendanceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_segmented_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/cm_text_secondary"
                        android:textSize="11.5sp"
                        tools:text="📊 91.5% Attendance" />

                    <!-- Card UID Badge -->
                    <TextView
                        android:id="@+id/tvCardUidBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_segmented_container"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/cm_text_muted"
                        android:textSize="11.5sp"
                        tools:text="UID: ••••7B12" />
                </com.google.android.flexbox.FlexboxLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- A. Contact Buttons (When Phone is Available) -->
        <LinearLayout
            android:id="@+id/layoutContactActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallOwner"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Call Student"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:backgroundTint="#10B981"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_phone"
                app:iconGravity="textStart"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWhatsappOwner"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="WhatsApp"
                android:textColor="#25D366"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_whatsapp"
                app:iconGravity="textStart"
                app:iconTint="#25D366"
                app:strokeColor="#25D366" />
        </LinearLayout>

        <!-- B. Missing Phone Notice (Graceful Empty State) -->
        <LinearLayout
            android:id="@+id/layoutMissingContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_info"
                app:tint="@color/cm_text_muted"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Phone Number Listed"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="The owner has not added a contact number. You can report this card to your CR or campus office."
                    android:textColor="@color/cm_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Secondary Action Row: Copy Roll & Share Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyRoll"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Copy Roll"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_copy"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:strokeColor="@color/cm_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareCard"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Share Card Info"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconSize="14dp"
                app:strokeColor="@color/cm_border" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. UNREGISTERED CARD EMPTY STATE -->
    <LinearLayout
        android:id="@+id/layoutUnregisteredCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/cm_surface"
            app:strokeColor="@color/cm_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_segmented_container">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_rfid_signal"
                        app:tint="@color/cm_text_muted"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Unregistered Smart Card"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUnregisteredCardUid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_segmented_container"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/cm_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Card UID: ••••7B12" />

                <TextView
                    android:id="@+id/tvUnregisteredHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="This card is blank or has not yet been linked to any student profile on ClassMate."
                    android:textColor="@color/cm_text_muted"
                    android:textSize="12.5sp" />

                <!-- Action Button for Admins / CRs -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAssignUnregisteredCard"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="Assign This Card to Student"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="@color/cm_primary"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
