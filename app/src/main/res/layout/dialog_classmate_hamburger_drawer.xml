<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Status Bar Background Spacer (Differentiates status bar from drawer) -->
    <View
        android:id="@+id/drawerStatusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#E8EDF5" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D8DFEC" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutDrawerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="2dp"
            android:paddingBottom="32dp">

            <!-- Drag handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_bottom_sheet_handle" />

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:text="classmate"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:text="."
                    android:textColor="@color/cm_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnDrawerClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/cm_text_secondary"
                android:contentDescription="Close drawer" />
        </RelativeLayout>

        <!-- User Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardUserProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/cm_border"
            app:cardBackgroundColor="@color/cm_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivDrawerAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_avatar_placeholder"
                    android:scaleType="centerCrop"
                    android:contentDescription="User Avatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDrawerUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:textSize="15sp"
                        android:textColor="@color/cm_text_primary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Khosh Afroza Akter" />

                    <TextView
                        android:id="@+id/tvDrawerUserSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="12sp"
                        android:textColor="@color/cm_text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="CE25057 · cse 22" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDrawerRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="#16A34A"
                    tools:text="Student" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION: CAMPUS & ACADEMIC -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUS &amp; ACADEMIC"
            android:textSize="11sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:letterSpacing="0.08"
            android:textColor="@color/cm_text_muted"
            android:layout_marginBottom="8dp" />

        <!-- Item: MBSTU Bus Transit -->
        <LinearLayout
            android:id="@+id/menuBusTransit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_bus_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bus_filled"
                    app:tint="#2563EB" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MBSTU Bus Transit"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Live bus radar, schedule &amp; routes"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Item: Teachers Directory -->
        <LinearLayout
            android:id="@+id/menuTeachers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_teacher_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_academic_cap"
                    app:tint="#7C3AED" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teachers Directory"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Faculty contacts &amp; assigned courses"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cm_border"
            android:layout_marginVertical="10dp" />

        <!-- SECTION: BATCH HUB -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BATCH HUB"
            android:textSize="11sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:letterSpacing="0.08"
            android:textColor="@color/cm_text_muted"
            android:layout_marginBottom="8dp" />

        <!-- Item: Batchmates -->
        <LinearLayout
            android:id="@+id/menuBatchmates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_batch_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_batch_friends"
                    app:tint="#0D9488" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batchmates"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Student roster, rolls &amp; contact info"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Item: Batch Fund -->
        <LinearLayout
            android:id="@+id/menuBatchFund"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_fund_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_fund_wallet"
                    app:tint="#EA580C" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Batch Fund"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Treasury balance, collections &amp; expenses"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cm_border"
            android:layout_marginVertical="10dp" />

        <!-- SECTION: CAMPUS TOOLS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAMPUS UTILITIES"
            android:textSize="11sp"
            android:fontFamily="@font/plus_jakarta_sans_bold"
            android:letterSpacing="0.08"
            android:textColor="@color/cm_text_muted"
            android:layout_marginBottom="8dp" />

        <!-- Item: Routine Export -->
        <LinearLayout
            android:id="@+id/menuExportRoutine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_share_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share_outline"
                    app:tint="#4338CA" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export Class Routine"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Share weekly routine via WhatsApp"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Item: Blood Donor Directory -->
        <LinearLayout
            android:id="@+id/menuBloodDirectory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_blood_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_blood_drop"
                    app:tint="#DC2626" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blood Donor Directory"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Campus emergency blood donors"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Item: Emergency Hotlines -->
        <LinearLayout
            android:id="@+id/menuEmergencyContacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="11dp"
            android:paddingHorizontal="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_tile_emergency_icon">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="#D97706" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Hotlines"
                    android:textSize="14.5sp"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:textColor="@color/cm_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Proctor, Medical Center &amp; Ambulance"
                    android:textSize="12sp"
                    android:textColor="@color/cm_text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_text_muted" />
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvDrawerFooterVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="ClassMate · MBSTU Student Companion"
            android:textSize="11.5sp"
            android:textColor="@color/cm_text_muted" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
