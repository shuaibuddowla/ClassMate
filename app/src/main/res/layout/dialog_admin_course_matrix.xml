<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMatrixCourseCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#10B981"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="CSE 2105" />

            <TextView
                android:id="@+id/tvMatrixCourseTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cm_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Computer Organization &amp; Architecture" />

            <TextView
                android:id="@+id/tvMatrixSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cm_text_muted"
                android:textSize="11.5sp"
                tools:text="4 Sessions · 58 Enrolled Students · 91% Avg" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMatrixExportExcel"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Excel"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#10B981"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_download_outline"
            app:iconTint="@android:color/white" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="@color/cm_border" />

    <ProgressBar
        android:id="@+id/progressMatrix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp" />

    <TextView
        android:id="@+id/tvMatrixEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center"
        android:text="No attendance sessions recorded yet for this course."
        android:textColor="@color/cm_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Horizontal Scroll Table Container for Matrix -->
    <HorizontalScrollView
        android:id="@+id/scrollMatrixTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="380dp">

            <TableLayout
                android:id="@+id/tableMatrix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:stretchColumns="*" />
        </ScrollView>
    </HorizontalScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMatrixClose"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:text="Close"
        android:textColor="@color/cm_text_primary"
        app:cornerRadius="10dp"
        app:strokeColor="@color/cm_border" />
</LinearLayout>
