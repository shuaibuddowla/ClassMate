<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRoot" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:clickable="true"
        android:focusable="true" app:cardCornerRadius="24dp"
        app:cardElevation="3dp" app:cardBackgroundColor="@color/cm_surface"
        app:strokeColor="@color/cm_notice_premium_stroke" app:strokeWidth="1dp">
        <LinearLayout android:id="@+id/noticeCardSurface"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_notice_premium_general"
            android:orientation="vertical" android:paddingStart="15dp"
            android:paddingTop="14dp" android:paddingEnd="15dp" android:paddingBottom="9dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="top" android:orientation="horizontal">
                <View android:id="@+id/noticeAccent" android:layout_width="4dp"
                    android:layout_height="28dp" android:layout_marginTop="2dp"
                    android:background="@drawable/bg_notice_premium_accent" />
                <TextView android:id="@+id/tvTitle" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp" android:layout_weight="1"
                    android:fontFamily="sans-serif-medium" android:maxLines="3"
                    android:ellipsize="end" android:textColor="@color/cm_text_primary"
                    android:textSize="18sp" android:textStyle="bold" />
                <ImageView android:id="@+id/btnOptions" android:layout_width="32dp"
                    android:layout_height="32dp" android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true" android:contentDescription="Edit or delete notice"
                    android:focusable="true" android:padding="5dp"
                    android:src="@drawable/ic_more_vert" app:tint="@color/cm_text_primary"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="16dp" android:layout_marginTop="5dp"
                android:gravity="top" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/tvPreview" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:ellipsize="end"
                        android:lineSpacingExtra="3dp" android:maxLines="4"
                        android:textColor="@color/cm_text_secondary" android:textSize="14sp" />
                    <TextView android:id="@+id/tvMeta" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:drawableStart="@drawable/ic_notice_date_small" android:drawablePadding="6dp"
                        android:ellipsize="end" android:maxLines="1"
                        android:textColor="@color/cm_text_muted" android:textSize="11sp" />
                </LinearLayout>
                <ImageView android:id="@+id/ivNoticeIllustration"
                    android:layout_width="70dp" android:layout_height="78dp"
                    android:layout_marginStart="6dp" android:alpha="0.64"
                    android:importantForAccessibility="no" android:scaleType="fitCenter"
                    android:src="@drawable/ic_notice_megaphone_art" />
            </LinearLayout>
            <FrameLayout android:id="@+id/imagePreviewContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:visibility="gone">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreview" android:layout_width="match_parent"
                    android:layout_height="140dp" android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedCornersImage" />
                <TextView android:id="@+id/tvTapToView" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="bottom|end"
                    android:layout_margin="8dp" android:background="#BB000000"
                    android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                    android:text="Tap to view" android:textColor="#FFFFFF" android:textSize="11sp" />
            </FrameLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fileAttachmentContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:visibility="gone" app:cardBackgroundColor="@color/cm_notice_attachment"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:strokeColor="@color/cm_notice_premium_stroke" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:padding="10dp">
                    <TextView android:id="@+id/tvFileExtension" android:layout_width="34dp"
                        android:layout_height="34dp" android:background="@drawable/bg_notice_premium_resource"
                        android:gravity="center" android:textColor="@color/cm_notice_premium_resource"
                        android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvFileName" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:ellipsize="middle"
                            android:maxLines="1" android:textColor="@color/cm_text_primary"
                            android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvFileSize" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/cm_text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/btnOpenFile" android:layout_width="30dp"
                        android:layout_height="30dp" android:contentDescription="Open file"
                        android:padding="6dp" android:src="@drawable/ic_open_external"
                        app:tint="@color/cm_notice_premium_resource" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="12dp" android:background="@color/cm_notice_premium_stroke" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/btnReminder" android:layout_width="30dp"
                    android:layout_height="30dp" android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true" android:contentDescription="Set notice reminder"
                    android:focusable="true">
                    <ImageView android:id="@+id/ivReminderIcon" android:layout_width="19dp"
                        android:layout_height="19dp" android:layout_gravity="center"
                        android:src="@drawable/ic_notice_reminder_outline"
                        app:tint="@color/cm_text_muted" />
                </FrameLayout>
                <LinearLayout android:id="@+id/btnReadReceipts" android:layout_width="0dp"
                    android:layout_height="30dp" android:layout_marginStart="4dp"
                    android:layout_weight="1" android:clickable="true" android:focusable="true"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <FrameLayout android:id="@+id/seenAvatars"
                        android:layout_width="24dp" android:layout_height="20dp"
                        android:layout_marginEnd="4dp" android:visibility="gone">
                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/ivSeenMeAvatar" android:layout_width="20dp"
                            android:layout_height="20dp" android:layout_gravity="start|center_vertical"
                            android:contentDescription="Your view" />
                    </FrameLayout>
                    <TextView android:id="@+id/tvReadCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end" android:maxLines="1"
                        android:textColor="@color/cm_text_muted" android:textSize="11sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/btnLike" android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center_vertical" android:minWidth="38dp"
                    android:orientation="horizontal" android:paddingHorizontal="2dp">
                    <ImageView android:id="@+id/ivLikeIcon" android:layout_width="17dp"
                        android:layout_height="17dp" android:src="@drawable/ic_heart_outline"
                        app:tint="@color/cm_notice_like" />
                    <TextView android:id="@+id/tvLikeCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="4dp"
                        android:textColor="@color/cm_text_primary" android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/btnComment" android:layout_width="wrap_content"
                    android:layout_height="30dp" android:layout_marginStart="7dp"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true" android:focusable="true"
                    android:gravity="center_vertical" android:minWidth="38dp"
                    android:orientation="horizontal" android:paddingHorizontal="2dp">
                    <ImageView android:layout_width="17dp" android:layout_height="17dp"
                        android:src="@drawable/ic_comment_outline" app:tint="@color/cm_text_muted" />
                    <TextView android:id="@+id/tvCommentCount" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="4dp"
                        android:textColor="@color/cm_text_primary" android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <!-- IDs retained for the older adapter; this Supabase card presents no tag or pin UI. -->
            <LinearLayout android:layout_width="0dp" android:layout_height="0dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvTypeLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSubject" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvBullet" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvCountdown" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvAuthorAvatarLetter" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvAuthorName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/ivAuthorAvatar"
                    android:layout_width="1dp" android:layout_height="1dp" />
                <FrameLayout android:id="@+id/fileIconContainer" android:layout_width="1dp"
                    android:layout_height="1dp" />
                <ImageView android:id="@+id/btnPin" android:layout_width="1dp"
                    android:layout_height="1dp" android:src="@drawable/ic_pin_outline" />
                <ImageView android:id="@+id/ivCommentIcon" android:layout_width="1dp"
                    android:layout_height="1dp" android:src="@drawable/ic_comment_outline" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
