<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/cardRoot"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clickable="false" android:focusable="false" app:cardCornerRadius="20dp"
        app:cardElevation="0dp" app:cardBackgroundColor="@android:color/transparent"
        app:cardPreventCornerOverlap="false" app:cardUseCompatPadding="false"
        android:clipToOutline="true"
        app:strokeColor="@color/cm_notice_premium_stroke" app:strokeWidth="1dp">
        <LinearLayout android:id="@+id/noticeCardSurface" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@drawable/bg_notice_premium_general"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="14dp" android:paddingBottom="2dp"
            android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout
                    android:id="@+id/titleContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View android:id="@+id/noticeAccent"
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:minHeight="22dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/bg_notice_premium_accent" />
                    <TextView android:id="@+id/tvTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:textColor="@color/cm_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:autoSizeTextType="uniform"
                        app:autoSizeMinTextSize="12sp"
                        app:autoSizeMaxTextSize="20sp"
                        app:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <ImageView android:id="@+id/ivNoticeIllustration"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.95"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notice_megaphone_art" />
                <ImageView android:id="@+id/btnOptions"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Edit or delete notice"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/cm_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/tvPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layout_marginEnd="4dp" android:includeFontPadding="false"
                android:lineSpacingExtra="3dp" android:maxLines="5" android:ellipsize="end"
                android:textColor="@color/cm_text_primary" android:textSize="15sp" />

            <!-- Interactive Material 3 Expressive Poll Container -->
            <LinearLayout android:id="@+id/pollContainer"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp" android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView android:id="@+id/tvPollChip"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="POLL" android:textSize="10.5sp" android:textStyle="bold"
                        android:textColor="#7C3AED" android:background="@drawable/bg_poll_chip"
                        android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
                    <TextView android:id="@+id/tvPollSubtext"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="8dp"
                        android:textColor="@color/cm_text_secondary" android:textSize="11.5sp"
                        android:maxLines="1" android:ellipsize="end" />
                </LinearLayout>
                <LinearLayout android:id="@+id/pollOptionsList"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" />
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <TextView android:id="@+id/tvPollTotalVotes"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textColor="@color/cm_text_secondary"
                        android:textSize="11.5sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView android:id="@+id/tvPollViewVotes"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="View votes ›"
                        android:textColor="#EF4444"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout android:id="@+id/imagePreviewContainer"
                android:layout_width="match_parent" android:layout_height="180dp"
                android:layout_marginTop="10dp" android:visibility="gone">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPreview" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/RoundedCornersImage" />
                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/imageCarouselPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                <TextView android:id="@+id/tvCarouselIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_carousel_pill"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView android:id="@+id/tvTapToView" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="bottom|end"
                    android:layout_margin="8dp" android:background="@drawable/bg_carousel_pill"
                    android:paddingHorizontal="10dp" android:paddingVertical="4dp"
                    android:text="Tap to view" android:textColor="#FFFFFF" android:textSize="11sp" />
            </FrameLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/assessmentAttachmentContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:visibility="gone" app:cardBackgroundColor="@color/cm_notice_attachment"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:strokeColor="@color/cm_notice_premium_stroke" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:padding="10dp">
                    <TextView android:id="@+id/tvAssessmentBadge" android:layout_width="34dp"
                        android:layout_height="34dp" android:background="@drawable/bg_badge_purple"
                        android:gravity="center" android:textColor="@color/cm_primary"
                        android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvAssessmentName" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:ellipsize="middle"
                            android:maxLines="1" android:textColor="@color/cm_text_primary"
                            android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvAssessmentSubtext" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/cm_text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/btnOpenAssessment" android:layout_width="30dp"
                        android:layout_height="30dp" android:contentDescription="Open assessment"
                        android:padding="6dp" android:src="@drawable/ic_open_external"
                        app:tint="@color/cm_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/fileAttachmentContainer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:visibility="gone" app:cardBackgroundColor="@color/cm_notice_attachment"
                app:cardCornerRadius="14dp" app:cardElevation="0dp"
                app:strokeColor="@color/cm_notice_premium_stroke" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:padding="10dp">
                    <TextView android:id="@+id/tvFileExtension" android:layout_width="34dp"
                        android:layout_height="34dp" android:background="@drawable/bg_notice_premium_resource"
                        android:gravity="center" android:textColor="@color/cm_notice_premium_resource"
                        android:textSize="10sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvFileName" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:ellipsize="middle"
                            android:maxLines="1" android:textColor="@color/cm_text_primary"
                            android:textSize="12sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvFileSize" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:textColor="@color/cm_text_muted"
                            android:textSize="10sp" />
                    </LinearLayout>
                    <ImageView android:id="@+id/btnOpenFile" android:layout_width="30dp"
                        android:layout_height="30dp" android:contentDescription="Open file"
                        android:padding="6dp" android:src="@drawable/ic_open_external"
                        app:tint="@color/cm_notice_premium_resource" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Notice Metadata (Date, Translate, Pinned) positioned under file container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/tvMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:drawableStart="@drawable/ic_notice_date_small" android:drawablePadding="6dp"
                    android:drawableTint="@color/cm_text_secondary" android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/cm_text_secondary" android:textSize="11sp" />
                <TextView android:id="@+id/btnTranslate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical" android:drawableStart="@drawable/ic_translate_small"
                    android:drawablePadding="5dp" android:text="Translate" android:textSize="11sp"
                    android:textColor="@color/cm_primary" android:background="@drawable/bg_btn_translate"
                    android:clickable="true" android:focusable="true"
                    android:paddingHorizontal="6dp" android:paddingVertical="3dp" />
                <TextView android:id="@+id/tvPinnedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:text="📌 Pinned"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/cm_primary"
                    android:background="@drawable/bg_date_header_pill"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp"
                    android:visibility="gone" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="2dp" android:background="@color/cm_notice_premium_stroke" android:alpha="0.6" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:clipChildren="false" android:clipToPadding="false">

                <!-- Left-aligned Social Actions (Like, Comment, Share) with comfortably expanded spacing, no bubble/ripple -->
                <LinearLayout android:id="@+id/btnLike" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:background="@null" android:clickable="true" android:focusable="true"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:contentDescription="Like notice" android:gravity="center_vertical"
                    android:orientation="horizontal" android:paddingStart="0dp" android:paddingEnd="8dp">
                    <ImageView android:id="@+id/ivLikeIcon" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_heart_outline" app:tint="@color/cm_text_secondary" />
                    <TextView android:id="@+id/tvLikeCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="5dp" android:textColor="@color/cm_text_secondary" android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btnComment" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:background="@null" android:clickable="true" android:focusable="true"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:contentDescription="Open comments" android:gravity="center_vertical"
                    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_comment_outline" app:tint="@color/cm_text_secondary" />
                    <TextView android:id="@+id/tvCommentCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="5dp" android:textColor="@color/cm_text_secondary" android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout android:id="@+id/btnShare" android:layout_width="38dp" android:layout_height="48dp"
                    android:background="@null" android:clickable="true" android:focusable="true"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:contentDescription="Share notice">
                    <ImageView android:id="@+id/ivShareIcon" android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="center" android:src="@drawable/ic_share" app:tint="@color/cm_text_secondary" />
                </FrameLayout>

                <!-- Retained hidden stub for backward compatibility -->
                <FrameLayout android:id="@+id/btnReminder" android:layout_width="0dp" android:layout_height="0dp"
                    android:visibility="gone">
                    <ImageView android:id="@+id/ivReminderIcon" android:layout_width="0dp" android:layout_height="0dp" />
                </FrameLayout>

                <!-- Spacer pushing Read Receipts to far right -->
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                <!-- Read Receipts: Up to 3 Profile Avatars + +N Count Badge on far right -->
                <LinearLayout android:id="@+id/btnReadReceipts" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:clickable="true" android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical|end" android:orientation="horizontal"
                    android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:layout_marginEnd="4dp"
                    android:clipChildren="false" android:clipToPadding="false">
                    <FrameLayout android:id="@+id/seenAvatars" android:layout_width="wrap_content" android:layout_height="24dp"
                        android:clipChildren="false" android:clipToPadding="false"
                        android:visibility="gone" />
                    <TextView android:id="@+id/tvReadCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <!-- IDs retained for the older adapter; this Supabase card presents no tag or pin UI. -->
            <LinearLayout android:layout_width="0dp" android:layout_height="0dp"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvTypeLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvSubject" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvBullet" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvCountdown" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvAuthorAvatarLetter" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvAuthorName" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <de.hdodenhof.circleimageview.CircleImageView android:id="@+id/ivAuthorAvatar"
                    android:layout_width="1dp" android:layout_height="1dp" />
                <FrameLayout android:id="@+id/fileIconContainer" android:layout_width="1dp"
                    android:layout_height="1dp" />
                <ImageView android:id="@+id/btnPin" android:layout_width="1dp"
                    android:layout_height="1dp" android:src="@drawable/ic_pin_outline" />
                <ImageView android:id="@+id/ivCommentIcon" android:layout_width="1dp"
                    android:layout_height="1dp" android:src="@drawable/ic_comment_outline" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
