<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/cm_surface"
    app:cardCornerRadius="28dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cm_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:gravity="center_horizontal">

        <!-- Visual Icon Badge -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_settings_icon"
            android:backgroundTint="#1A2563EB">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                app:tint="@color/cm_primary"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Add a Profile Photo"
            android:textColor="@color/cm_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans_extrabold"
            android:gravity="center" />

        <!-- Subtitle / Explanation -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Help your classmates and teachers recognize you in batch discussions, notices, and live attendance."
            android:textColor="@color/cm_text_secondary"
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp"
            android:gravity="center" />

        <!-- Primary Action: Upload Photo -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPromptUpload"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:text="Upload Photo"
            android:textColor="@android:color/white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cm_primary"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add_photo_alternate"
            app:iconTint="@android:color/white"
            app:iconGravity="textStart" />

        <!-- Secondary Action: Later -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPromptLater"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:text="Maybe Later"
            android:textColor="@color/cm_text_secondary"
            android:textSize="13.5sp"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
