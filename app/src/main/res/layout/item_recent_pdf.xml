<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_library_row_divider_html"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_library_file_icon_red">
        <ImageView android:id="@+id/ivFileIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_file_pdf" app:tint="#FF6B7A" />
        <TextView android:id="@+id/tvFileBadge" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="PDF" android:textColor="#DC2626" android:textSize="9sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#12152A" android:textSize="14sp" android:textStyle="bold" tools:text="Boolean algebra and K-maps" />
        <TextView android:id="@+id/tvSubject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1" android:textColor="#2F45F0" android:textSize="12sp" tools:text="Digital Electronics" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_clock" app:tint="#565C75" />
            <TextView android:id="@+id/tvFileMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:textColor="#565C75" android:textSize="10.5sp" tools:text="2 days ago - 3.2 MB" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/btnFavorite" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="11dp" android:src="@drawable/ic_star_outline" app:tint="#565C75" />
    <TextView android:id="@+id/tvLabTag" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ImageView android:id="@+id/btnDelete" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/btnDownloadView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <ProgressBar android:id="@+id/progressDownload" style="?android:attr/progressBarStyleHorizontal" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>
