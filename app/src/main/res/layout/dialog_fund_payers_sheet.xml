<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="640dp"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CBD5E1"
        android:layout_marginBottom="14dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payers Tracker"
        android:textColor="@color/cm_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPayersSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track all batchmates' contributions &amp; dues by collection title."
        android:textColor="@color/cm_text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <!-- Collection Filter Chips (Horizontally Scrollable) -->
    <HorizontalScrollView
        android:id="@+id/hsvPayersCollections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPayersCollections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- Search Box -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:boxBackgroundMode="outline"
        app:startIconDrawable="@drawable/ic_search_modern">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPayersSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search by name or student ID"
            android:singleLine="true"
            android:textSize="13sp"
            android:textColor="@color/cm_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Shimmer Skeleton Loading -->
    <include
        android:id="@+id/shimmerPayers"
        layout="@layout/shimmer_fund_list"
        android:visibility="gone" />

    <include
        android:id="@+id/emptyStatePayers"
        layout="@layout/view_empty_state"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/payersItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
