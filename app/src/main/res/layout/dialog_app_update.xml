<?xml version="1.0" encoding="utf-8"?>
<!-- C:/Users/USER/AndroidStudioProjects/ClassMate/app/src/main/res/layout/dialog_app_update.xml -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/cm_surface"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/cm_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:gravity="center_horizontal">

        <!-- App Icon with Update Badge Header -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp">

            <!-- Rounded Squircle Icon Container -->
            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_update_icon_container"/>

            <!-- 3D ClassMate Logo -->
            <ImageView
                android:id="@+id/ivUpdateIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_classmate_logo"
                android:importantForAccessibility="no"/>

            <!-- Vibrant Update Indicator Badge -->
            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_update_badge">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_upload_arrow"
                    android:importantForAccessibility="no"/>
            </FrameLayout>
        </FrameLayout>

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tvUpdateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New Update Available"
            android:textColor="@color/cm_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvUpdateSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A newer version of ClassMate is ready with new features, stability fixes, and improvements."
            android:textColor="@color/cm_text_secondary"
            android:textSize="13.5sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="6dp"/>

        <!-- Version Transition Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="@drawable/bg_version_container">

            <TextView
                android:id="@+id/tvLocalVersionPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_version_pill_installed"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/cm_version_pill_installed_text"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="v1.1.31"/>

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="8dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/cm_primary"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/tvUpdateVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_version_pill_target"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="v1.1.33"/>
        </LinearLayout>

        <!-- Changelog Container (Card-in-card style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_changelog_card"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_sparkle"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHAT'S NEW"
                    android:textColor="@color/cm_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"/>
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvChangelog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fadeScrollbars="true"
                android:scrollbars="vertical"
                android:overScrollMode="never">

                <TextView
                    android:id="@+id/tvUpdateChangelog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="•  Added interactive bus schedules\n\n•  UI design updates\n\n•  Bug fixes"/>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- Progress Indicator Section -->
        <LinearLayout
            android:id="@+id/layoutDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="18dp"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/pbDownloadProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progressDrawable="@drawable/bg_poll_progress"
                android:max="100"
                android:progress="0"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDownloadProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Downloading: 0% (0.0 MB / 0.0 MB)"
                android:textColor="@color/cm_text_secondary"
                android:textSize="11sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Action Buttons Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnUpdateLater"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="0.85"
                android:background="@drawable/bg_update_btn_outline"
                android:text="Later"
                android:textColor="@color/cm_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btnUpdateNow"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_update_btn_primary"
                android:text="Update Now"
                android:textColor="@android:color/white"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingHorizontal="10dp"
                android:textAllCaps="false"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
