<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:background="@drawable/bg_library_row_divider_html"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">

    <FrameLayout android:id="@+id/iconContainer" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_library_file_icon_blue">
        <ImageView android:id="@+id/ivSubjectIcon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_library_outline" app:tint="@color/cm_primary" />
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvSubjectName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="@color/cm_text_primary" android:textSize="14sp" android:textStyle="bold" tools:text="Digital Electronics" />
        <TextView android:id="@+id/tvSubjectCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/cm_text_secondary" android:textSize="11sp" tools:text="CSE1205" />
    </LinearLayout>

    <TextView android:id="@+id/tvPdfCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="end" android:textColor="@color/cm_text_secondary" android:textSize="11sp" tools:text="8 files" />
    <ImageView android:id="@+id/btnManageCourse" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginStart="4dp" android:padding="7dp" android:contentDescription="Manage course" android:src="@drawable/ic_more_vert" android:visibility="gone" app:tint="@color/cm_text_secondary" />
    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="6dp" android:src="@drawable/ic_chevron_right" app:tint="@color/cm_text_secondary" />
</LinearLayout>
