<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPollOption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeColor="@color/cm_notice_premium_stroke"
    app:strokeWidth="1.2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false">

        <!-- Fluid Progress Fill Track -->
        <View
            android:id="@+id/viewProgressTrack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false"
            android:background="#248B5CF6" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:focusable="false"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp">

            <!-- Selection Indicator (Radio or Checkbox) -->
            <ImageView
                android:id="@+id/ivPollIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:clickable="false"
                android:focusable="false"
                android:src="@drawable/ic_poll_circle_unselected" />

            <!-- Option Text -->
            <TextView
                android:id="@+id/tvOptionText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/cm_text_primary"
                android:textSize="14sp"
                android:clickable="false"
                android:focusable="false"
                android:includeFontPadding="false" />

            <!-- Stats Block (Percentage and Vote count) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:clickable="false"
                android:focusable="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOptionPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/cm_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="false"
                    android:focusable="false"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tvOptionVotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cm_text_muted"
                    android:textSize="10.5sp"
                    android:clickable="false"
                    android:focusable="false"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
