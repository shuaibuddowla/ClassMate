# ==============================================================================
# ClassMate Web - Environment Variables Template
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit your actual .env.local file to source control!
# ==============================================================================

# Supabase Configuration (Required for database, auth, and real-time data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Supabase Service Role Key (Required for server-side API endpoints: /api/scan, /api/export-attendance)
# Keep this strictly server-side; do NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Firebase Cloud Messaging (Optional: For browser web push notifications)
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"your-api-key","authDomain":"your-app.firebaseapp.com","projectId":"your-project-id","messagingSenderId":"your-sender-id","appId":"your-app-id"}
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key
