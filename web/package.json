{
  "name": "classmate-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-worker.mjs && node node_modules/next/dist/bin/next dev",
    "build": "node scripts/build-worker.mjs && node node_modules/next/dist/bin/next build --webpack",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.90.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
